{
    "name": "@koslibs/builder",
    "version": "0.1.0",
    "description": "Shared React application and ESM library toolchain powered by Rspack",
    "type": "module",
    "license": "MIT",
    "author": "holypower777",
    "engines": {
        "node": ">=24.13.0"
    },
    "bin": {
        "koslibs-builder": "./dist/cli/index.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/typings/client.d.ts"
        },
        "./storybook": {
            "types": "./dist/storybook/index.d.ts",
            "import": "./dist/storybook/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.js"
        },
        "./rstest": {
            "types": "./dist/testing/rstest.d.ts",
            "import": "./dist/testing/rstest.js"
        },
        "./playwright": {
            "types": "./dist/testing/playwright.d.ts",
            "import": "./dist/testing/playwright.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "rstest run",
        "test:watch": "rstest watch",
        "test:coverage": "rstest run --coverage",
        "test:integration": "node scripts/integration.mjs",
        "test:package": "node scripts/package-smoke.mjs",
        "lint": "koslibs-lint lint",
        "lint:fix": "koslibs-lint lint:fix",
        "lint:js": "koslibs-lint js",
        "lint:js:fix": "koslibs-lint js --fix",
        "format": "koslibs-lint format",
        "format:check": "koslibs-lint format:check",
        "prepack": "node scripts/build.mjs",
        "version-package:patch": "npm version patch --no-git-tag-version",
        "release": "npm publish --access public"
    },
    "dependencies": {
        "@playwright/test": "1.63.0",
        "@rsbuild/core": "2.2.11",
        "@rsbuild/plugin-react": "2.1.1",
        "@rsbuild/plugin-type-check": "1.6.0",
        "@rslib/core": "1.0.3",
        "@rstest/core": "0.12.3",
        "@rstest/coverage-istanbul": "0.12.3",
        "@storybook/addon-docs": "10.6.1",
        "happy-dom": "20.14.5",
        "storybook": "10.6.1",
        "storybook-react-rsbuild": "3.6.0",
        "typescript": "5.9.3"
    },
    "devDependencies": {
        "@koslibs/configs": "0.2.11",
        "@types/node": "^24.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "peerDependencies": {
        "@koslibs/configs": "^0.2.11",
        "react": "^18.3.1 || ^19.0.0",
        "react-dom": "^18.3.1 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/koslibs/builder.git"
    }
}
